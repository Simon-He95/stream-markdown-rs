{
  "name": "stream-markdown-rs-validation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "test": "pnpm test:reference && pnpm test:differential",
    "test:reference": "node scripts/unpack-reference.mjs && vitest run",
    "test:differential": "node scripts/unpack-reference.mjs && tsx scripts/differential.mjs",
    "test:candidate": "node scripts/unpack-reference.mjs && tsx scripts/test-candidate.mjs",
    "test:spec": "tsx scripts/conformance.mjs",
    "bench": "node scripts/unpack-reference.mjs && tsx --expose-gc scripts/benchmark.mjs"
  },
  "devDependencies": {
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-container": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-checkbox": "1.0.6",
    "markdown-it-ts": "1.1.3",
    "tsx": "4.21.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "patchedDependencies": {
      "markdown-it-ts@1.1.3": "patches/markdown-it-ts@1.1.3.patch"
    }
  }
}
